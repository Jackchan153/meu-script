-- FUNÇÃO DE ROLETAR: 100% de CHANCE FRUTA MÍTICA com Luck ON --
-----------------------------------------------------------------
local frutas = {
    {"Chop", 0.55},  -- comum
    {"Bomb", 0.40},  -- comum
    {"Ice", 0.035},  -- rara
    {"Light", 0.012},-- lendária
    {"Dragon", 0.003}-- mítica
}

function RolarFruta()
    local ganhou
    if luckActive then
        -- Busca automaticamente a fruta mítica (a última da lista neste exemplo)
        for i,fruit in ipairs(frutas) do
            if fruit[1]=="Dragon" then 
                ganhou = fruit[1]
                break
            end
        end
        info.Text = "Você tirou: " .. (ganhou or "??") .. " (MÍTICA GARANTIDA!)"
        print("[Luck 100%] Rolou fruta:", ganhou)
        return ganhou
    else
        -- Método normal: chances padrão
        local chancesAcumuladas, total = {}, 0
        for i, v in ipairs(frutas) do
            local chance = v[2]
            total = total + chance
            table.insert(chancesAcumuladas, {v[1], total})
        end
        local sorteio = math.random() * total
        local idx = 1
        for i, v in ipairs(chancesAcumuladas) do
            if sorteio <= v[2] then
                idx = i
                break
            end
        end
        ganhou = chancesAcumuladas[idx][1]
        info.Text = "Você tirou: "..ganhou
        print("[Luck OFF] Rolou fruta:", ganhou)
        return ganhou
    end
end

roletarBtn.MouseButton1Click:Connect(RolarFruta)

