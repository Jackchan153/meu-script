local arrows = {}

local function createArrow(fruit)
    if not fruit:FindFirstChild("Handle") then return end
    if fruit.Handle:FindFirstChild("FruitArrowESP") then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "FruitArrowESP"
    billboard.Adornee = fruit.Handle
    billboard.Size = UDim2.new(0, 115, 0, 44)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = fruit.Handle

    local arrowLabel = Instance.new("TextLabel")
    arrowLabel.Parent = billboard
    arrowLabel.Size = UDim2.new(1, 0, 0.52, 0)
    arrowLabel.Position = UDim2.new(0, 0, 0, 0)
    arrowLabel.BackgroundTransparency = 1
    arrowLabel.Text = "▲"
    arrowLabel.Font = Enum.Font.GothamBold
    arrowLabel.TextSize = 24
    arrowLabel.TextColor3 = Color3.fromRGB(242, 203, 74)
    arrowLabel.TextStrokeTransparency = 0.2

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Parent = billboard
    nameLabel.Size = UDim2.new(1, 0, 0.48, 0)
    nameLabel.Position = UDim2.new(0, 0, 0.52, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = fruit.Name
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 13
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0.6
end

local function updateArrows()
    for fruit, _ in pairs(arrows) do
        if not fruit or not fruit.Parent or not fruit:FindFirstChild("Handle") then
            arrows[fruit] = nil
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Tool") then
            if obj:FindFirstChild("Handle") and string.find(obj.Name, "Fruit") then
                if not obj.Handle:FindFirstChild("FruitArrowESP") then
                    createArrow(obj)
                    arrows[obj] = true
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        pcall(function()
            UpdateFruitList()
            updateArrows()
        end)
        wait(2)
    end
end)

UpdateFruitList()
updateArrows()
