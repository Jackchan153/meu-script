    item.Text = ""
    item.Parent = listFrame
    local corner = Instance.new("UICorner",item)
    corner.CornerRadius = UDim.new(0,15)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "Name"
    nameLabel.Size = UDim2.new(0.6, -8, 0.6, 0)
    nameLabel.Position = UDim2.new(0, 10, 0, 6)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = nameText
    nameLabel.Font = Enum.Font.GothamSemibold
    nameLabel.TextSize = 16
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = item

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "Distance"
    distLabel.Size = UDim2.new(0.34, -10, 0.55, 0)
    distLabel.Position = UDim2.new(0.64, 0, 0, 6)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = distanceText
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 14
    distLabel.TextColor3 = Color3.fromRGB(220,255,169)
    distLabel.TextXAlignment = Enum.TextXAlignment.Right
    distLabel.Parent = item

    local posLabel = Instance.new("TextLabel")
    posLabel.Name = "Position"
    posLabel.Size = UDim2.new(1, -10, 0.38, 0)
    posLabel.Position = UDim2.new(0, 10, 0.62, 0)
    posLabel.BackgroundTransparency = 1
    posLabel.Text = posText
    posLabel.Font = Enum.Font.Gotham
    posLabel.TextSize = 13
    posLabel.TextColor3 = Color3.fromRGB(153,215,255)
    posLabel.TextXAlignment = Enum.TextXAlignment.Left
    posLabel.TextWrapped = true
    posLabel.Parent = item

    return item
end

local function UpdateFruitList()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("GuiObject") and child ~= uiListLayout then
            child:Destroy()
        end
    end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        infoLabel.Text = "Personagem não carregado!"
        return
    end

    local encontrou = false
    for _, obj in ipairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj:FindFirstChild("Handle") and string.find(obj.Name, "Fruit") then
                encontrou = true
                local handle = obj.Handle
                local distance = (hrp.Position - handle.Position).Magnitude
                local distanciaTxt = string.format("%d studs", math.floor(distance))
                local posTxt = string.format("X:%.1f Y:%.1f Z:%.1f", handle.Position.X, handle.Position.Y, handle.Position.Z)
                local item = createListItem(obj.Name, distanciaTxt, posTxt)
                item.MouseButton1Click:Connect(function()
                    infoLabel.Text = "Selecionado: "..obj.Name.." — "..distanciaTxt
                end)
            end
        end)
    end

    local totalSize = uiListLayout.AbsoluteContentSize.Y
    listFrame.CanvasSize = UDim2.new(0, 0, 0, totalSize + 10)

    if not encontrou then
        infoLabel.Text = "Nenhuma fruta dropada encontrada!"
    else
        infoLabel.Text = "Clique em uma fruta para ver detalhes."
    end
end

-- Botões GUI
refreshBtn.MouseButton1Click:Connect(UpdateFruitList)
closeBtn.MouseButton1Click:Connect(function() screenGui.Enabled = false end)

UpdateFruitList()

